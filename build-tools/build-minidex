#!/usr/bin/env node
'use strict';

const fs = require("fs");
const path = require("path");
process.chdir(path.resolve(__dirname, '../play.pokemonshowdown.com'));
const imageSize = require('image-size');

const Dex = require('./../caches/DH2/dist/sim/dex').Dex;
const toID = Dex.toID;

process.stdout.write("Updating animated sprite dimensions... ");

/**
 * Where the animated sprite set lives. The Dystoria sprites are hosted on Cloudflare R2
 * (https://sprites.dystorialab.org/sprites/...) but the files are not in any git repo, so the
 * build reads sizes from build-tools/sprite-sizes.json.
 *
 * Set SPRITE_SRC=/path/to/sprites (same layout: ani/, ani-back/, ...) to regenerate that file from the real export.
 */
const spriteSrc = process.env.SPRITE_SRC && fs.existsSync(path.join(process.env.SPRITE_SRC, 'ani')) ?
	process.env.SPRITE_SRC : null;
if (process.env.SPRITE_SRC && !spriteSrc) {
	console.log(`\nSPRITE_SRC has no ani/ folder: ${process.env.SPRITE_SRC}`);
	process.exit(1);
}

const MANIFEST_FILE = path.resolve(__dirname, 'sprite-sizes.json');
const MANIFEST_DIRS = ['ani', 'ani-back', 'ani-shiny', 'ani-back-shiny', 'img', 'img-back', 'img-shiny', 'img-back-shiny'];
const manifest = spriteSrc ? buildManifest() : readManifest();

function readManifest() {
	if (!fs.existsSync(MANIFEST_FILE)) return null;
	return JSON.parse(fs.readFileSync(MANIFEST_FILE, 'utf8'));
}

function buildManifest() {
	const out = {};
	for (const dir of MANIFEST_DIRS) {
		out[dir] = {};
		const full = path.join(spriteSrc, dir);
		if (!fs.existsSync(full)) continue;
		for (const file of fs.readdirSync(full).filter(f => /\.(gif|png)$/.test(f)).sort()) {
			try {
				const size = imageSize(path.join(full, file));
				out[dir][file] = [size.width, size.height];
			} catch (e) {}
		}
	}
	const dirs = MANIFEST_DIRS.map(dir => {
		const rows = Object.entries(out[dir]).map(([file, size]) => `\t\t${JSON.stringify(file)}: [${size.join(', ')}]`);
		return `\t${JSON.stringify(dir)}: {\n${rows.join(',\n')}\n\t}`;
	});
	fs.writeFileSync(MANIFEST_FILE, `{\n${dirs.join(',\n')}\n}\n`);
	return out;
}

/**
 * Files in the R2 set don't always use the spriteid the client computes.
 * Returns candidate filenames (without extension), most preferred first.
 */
function fileCandidates(spriteid, speciesNameId) {
	const out = [spriteid];
	const alt = spriteid.replace(/-dystorian(?=-|$)/, '-dystoria');
	if (alt !== spriteid) out.push(alt);
	// some files drop the hyphen entirely (eg. spiritombdystorian.gif)
	for (const name of [spriteid, alt]) {
		const flat = name.replace(/-/g, '');
		if (!out.includes(flat)) out.push(flat);
	}
	// species whose dex entry has no base/forme split (eg. Hionishi-Katana) but whose file keeps the hyphen
	if (speciesNameId && !out.includes(speciesNameId)) out.push(speciesNameId);
	return out;
}

function sizeObj(dir, file) {
	const size = manifest[dir]?.[file];
	if (size) return {w: size[0], h: size[1]};
}

/** Find a sprite in `<spriteSrc>/<dir>/` under any candidate name. Returns {name, size}. */
function findSprite(dir, spriteid, suffix, speciesNameId) {
	for (const name of fileCandidates(spriteid, speciesNameId)) {
		const size = sizeObj(dir, name + suffix + '.gif');
		if (size) return {name, size};
	}
}

/** The upstream Pokemon Showdown size tables: used for species our own set doesn't cover. */
async function fetchRemote(file) {
	try {
		const res = await fetch('https://play.pokemonshowdown.com/data/' + file);
		if (!res.ok) throw new Error('HTTP ' + res.status);
		return await res.text();
	} catch (e) {
		console.log(`\nWarning: couldn't fetch upstream ${file} (${e.message}); species outside the Dystoria set won't animate`);
		return null;
	}
}

function parseRemote(text, exportName) {
	if (!text) return {};
	try {
		const exp = {};
		new Function('exports', text)(exp);
		return exp[exportName] || {};
	} catch (e) {
		return {};
	}
}

/**
 * Same fallback as the client's Species constructor: some custom entries (eg. Golduck-Dystorian) omit `forme`,
 * so derive it from "<Base>-<Forme>". Both sides must compute the same id or the row won't be found.
 */
function spriteIdOf(species) {
	let spriteid = species.spriteid;
	const baseId = toID(species.baseSpecies);
	if (!species.forme && baseId !== species.id && species.name.startsWith(species.baseSpecies + '-')) {
		spriteid = baseId + '-' + toID(species.name.slice(species.baseSpecies.length + 1));
	}
	return spriteid;
}

/**
 * The client sizes each <img> with these numbers, so they must match the real files exactly (a wrong aspect
 * ratio squashes the sprite). Static PNGs are often a different size from the GIFs, and a few shinies differ too.
 *   img/imgf = front, imgb/imgbf = back (static PNG, female variants);  s = shiny sizes, only where they differ.
 */
function addExactSizes(row, file) {
	const variants = [
		['front', 'ani', '', '.gif'], ['frontf', 'ani', '-f', '.gif'],
		['back', 'ani-back', '', '.gif'], ['backf', 'ani-back', '-f', '.gif'],
		['img', 'img', '', '.png'], ['imgf', 'img', '-f', '.png'],
		['imgb', 'img-back', '', '.png'], ['imgbf', 'img-back', '-f', '.png'],
	];
	const shiny = {};
	for (const [key, dir, suffix, ext] of variants) {
		const size = sizeObj(dir, file + suffix + ext);
		if (!size) continue;
		row[key] = size; // (re)set from the resolved filename
		const s = sizeObj(dir + '-shiny', file + suffix + ext);
		if (s && (s.w !== size.w || s.h !== size.h)) shiny[key] = s;
	}
	if (Object.keys(shiny).length) row.s = shiny;
}

function readJsonMap(name) {
	const file = path.resolve(__dirname, name);
	if (!fs.existsSync(file)) return {};
	try {
		return JSON.parse(fs.readFileSync(file, 'utf8'));
	} catch (e) {
		console.log(`\nWarning: couldn't read ${file} (${e.message}); ignoring it`);
		return {};
	}
}

function readScaleOverrides() {
	const data = readJsonMap('sprite-scale.json');
	const out = {};
	for (const key in data) {
		const value = Number(data[key]);
		if (!(value > 0)) {
			console.log(`\nWarning: ignoring invalid scale for ${key}: ${data[key]}`);
			continue;
		}
		out[toID(key)] = value;
	}
	return out;
}

/**
 * Sprite sizing: each render gets a multiplier (`sc`) that makes its on-screen size proportional to the same
 * Pokemon's sprite on Pokemon Showdown. Our renders all have similar dimensions, so without it Joltik is as big as Wailord.
 *
 * sprite-reference.json = {"fakemon": "pokemon to be the same size as"}
 * sprite-scale.json     = {"pokemon": exact multiplier}, which replaces the calculated one
 * showdown-sizes.json   = saved copy of Showdown's front sprite sizes (refresh with UPDATE_SHOWDOWN_SIZES=1)
 */
// Raise or lower this to resize every one of our sprites at once (1.2 = 20% bigger).
const SIZE_MULTIPLIER = 1;
// Showdown size / our size for the typical sprite. Fixed so that adding sprites never resizes existing ones.
const SIZE_RATIO = 0.376;
const MIN_SCALE = 0.5;
const MAX_SCALE = 2.2;
const SHOWDOWN_SIZES_FILE = path.resolve(__dirname, 'showdown-sizes.json');

const area = size => Math.sqrt(size.w * size.h);

function getShowdownSizes(upstream) {
	const exists = fs.existsSync(SHOWDOWN_SIZES_FILE);
	if (exists && !process.env.UPDATE_SHOWDOWN_SIZES) return readJsonMap('showdown-sizes.json');

	const out = {};
	for (const id of Object.keys(upstream).sort()) {
		const front = upstream[id].front;
		if (front && id !== 'substitute') out[id] = [front.w, front.h];
	}
	if (!Object.keys(out).length) return readJsonMap('showdown-sizes.json');
	const lines = Object.entries(out).map(([id, size]) => `\t${JSON.stringify(id)}: [${size.join(', ')}]`);
	fs.writeFileSync(SHOWDOWN_SIZES_FILE, `{\n${lines.join(',\n')}\n}\n`);
	return out;
}

function applyScales(rows, rowById, artParents, showdownSizes) {
	const overrides = readScaleOverrides();
	const references = {};
	for (const [key, value] of Object.entries(readJsonMap('sprite-reference.json'))) {
		references[toID(key)] = toID(value);
	}
	const entryById = new Map(rows.map(entry => [entry.id, entry]));
	// Many of Showdown's Gen 9 Mega sprites are fitted into a 90px box, so their size says nothing about the Pokemon
	showdownSizes = Object.fromEntries(Object.entries(showdownSizes).filter(([id, size]) => {
		const species = entryById.get(id)?.species;
		const longest = Math.max(...size);
		return !(species?.isMega && species.gen === 9 && longest >= 89 && longest <= 90);
	}));
	const scales = new Map();
	const resolving = new Set();
	const unsized = [];
	const badReferences = [];

	const isOurs = row => !!(row && !row.ps && row.front);

	/** On-screen size of a Pokemon, in the same units as `area(row.front) * sc` */
	function sizeOf(id) {
		const row = rowById.get(id);
		if (isOurs(row)) {
			const scale = scaleOf(id);
			return scale && area(row.front) * scale;
		}
		const size = showdownSizes[id];
		return size && area({w: size[0], h: size[1]}) / SIZE_RATIO;
	}

	function scaleOf(id) {
		if (scales.has(id)) return scales.get(id);
		if (resolving.has(id)) return null;
		resolving.add(id);

		const row = rowById.get(id);
		const clamp = value => Math.min(MAX_SCALE, Math.max(MIN_SCALE, value));
		const matching = targetId => {
			const size = targetId !== id && sizeOf(targetId);
			return size ? clamp(size / area(row.front)) : null;
		};

		let scale = overrides[id] || null;
		if (!scale && references[id]) {
			scale = matching(references[id]);
			if (!scale) badReferences.push(`${id} -> ${references[id]}`);
		}
		// a forme drawn with another forme's art is sized the same as it
		if (!scale && artParents.has(id)) scale = scaleOf(artParents.get(id));
		if (!scale && showdownSizes[id]) {
			const [w, h] = showdownSizes[id];
			scale = clamp(area({w, h}) / SIZE_RATIO / area(row.front));
		}
		if (!scale) {
			const baseId = toID(entryById.get(id).species.baseSpecies);
			if (baseId !== id) scale = matching(baseId);
		}

		resolving.delete(id);
		scales.set(id, scale);
		return scale;
	}

	for (const {id, row} of rows) {
		if (!isOurs(row)) continue;
		const scale = scaleOf(id);
		if (!scale) unsized.push(id);
		const rounded = Math.round((scale || 1) * SIZE_MULTIPLIER * 100) / 100;
		if (rounded !== 1) row.sc = rounded;
	}

	for (const id in references) {
		if (!isOurs(rowById.get(id))) badReferences.push(`${id} (no render of ours to resize)`);
	}
	if (badReferences.length) {
		console.log(`\nWarning: unusable entries in sprite-reference.json: ${[...new Set(badReferences)].join(', ')}`);
	}
	if (unsized.length) {
		console.log(`\nWarning: ${unsized.length} sprites have no size to copy; add them to build-tools/sprite-reference.json:\n${unsized.join(', ')}`);
	}
}

function rowToString(id, row) {
	return `\t${id}:` + JSON.stringify(row).replace(/"(\w+)":/g, '$1:') + `,\n`;
}

async function updateSizes() {
	const remoteText = await fetchRemote('pokedex-mini.js');
	const upstream = parseRemote(remoteText, 'BattlePokemonSprites');
	const remoteBWText = await fetchRemote('pokedex-mini-bw.js');

	let buf = `/*
DO NOT EDIT

THIS FILE IS AUTOGENERATED BY ./build-tools/build-minidex

Rows with front/back sizes come from the Dystoria R2 sprite set (sprites.dystorialab.org).
\`sid\` is the filename when it differs from the species' spriteid.
Rows marked \`ps:1\` fall back to upstream Pokemon Showdown's own sprites.
*/

exports.BattlePokemonSprites = {
	substitute:{exists:false, front:{w:34, h:39}, back:{w:37, h:38}},
`;

	const seen = new Set();
	const rows = [];
	const rowById = new Map();
	let r2Count = 0;
	let psCount = 0;
	for (let baseid in Dex.data.Pokedex) {
		let species = Dex.species.get(baseid);
		for (let formeName of [''].concat(species.cosmeticFormes || [])) {
			let spriteid = spriteIdOf(species);
			if (formeName) spriteid += '-' + toID(formeName).slice(species.id.length);
			if (spriteid.slice(-1) === '-') spriteid = spriteid.slice(0, -1);
			let id = toID(spriteid);
			if (seen.has(id)) continue;
			seen.add(id);

			const row = {num: species.num};
			const nameId = formeName ? '' : species.name.toLowerCase().replace(/[^a-z0-9-]+/g, '').replace(/^-+|-+$/g, '');
			const front = findSprite('ani', spriteid, '', nameId);
			const frontF = findSprite('ani', spriteid, '-f', nameId);
			const back = findSprite('ani-back', spriteid, '', nameId);
			const backF = findSprite('ani-back', spriteid, '-f', nameId);
			if (front) row.front = front.size;
			if (frontF) row.frontf = frontF.size;
			if (back) row.back = back.size;
			if (backF) row.backf = backF.size;
			const file = (front || back || frontF || backF || {}).name;
			if (file && file !== spriteid) row.sid = file;
			if (file) addExactSizes(row, file);

			if (row.front || row.back) {
				r2Count++;
			} else if (upstream[id] && (upstream[id].front || upstream[id].back)) {
				Object.assign(row, upstream[id], {num: species.num, ps: 1});
				psCount++;
			}
			rows.push({id, row, spriteid, species, own: !!(row.front || row.back) && !row.ps});
			rowById.set(id, row);
		}
	}

	// Battle-only formes (Terapagos-Terastal, Ogerpon-*-Tera, *-Gmax, ...) have no file of their own anywhere.
	// Reuse the closest parent's R2 render instead of falling back to a blank/placeholder: trim trailing
	// "-segments" off the spriteid (tatsugiri-curly-mega -> tatsugiri-curly -> tatsugiri), then the base species.
	let fallbackCount = 0;
	const artParents = new Map();
	const hasArt = r => r && (r.front || r.back);
	for (const {id, row, spriteid, species} of rows) {
		if (hasArt(row)) continue;
		const parents = [];
		const parts = spriteid.split('-');
		for (let n = parts.length - 1; n >= 1; n--) parents.push(toID(parts.slice(0, n).join('-')));
		parents.push(toID(species.baseSpecies));
		for (const parentId of parents) {
			const parent = rowById.get(parentId);
			if (!hasArt(parent) || parent.ps) continue;
			const fallbackRow = {};
			for (const key in parent) if (key !== 'num') fallbackRow[key] = parent[key];
			artParents.set(id, parentId);
			// the file belongs to the parent: use its filename
			const parentRow = rows.find(r => r.id === parentId);
			fallbackRow.sid = parent.sid || parentRow.spriteid;
			Object.assign(row, fallbackRow);
			fallbackCount++;
			break;
		}
	}
	let aliasCount = 0;
	const aliases = readJsonMap('sprite-alias.json');
	for (const {id, row, own} of rows) {
		const targetId = aliases[id] && toID(aliases[id]);
		if (!targetId || own) continue;
		const target = rowById.get(targetId);
		const targetEntry = rows.find(r => r.id === targetId);
		if (!hasArt(target) || target.ps || !targetEntry) {
			console.log(`\nWarning: sprite-alias.json maps ${id} to ${targetId}, which has no render in the sprite set`);
			continue;
		}
		for (const key of Object.keys(row)) if (key !== 'num') delete row[key];
		for (const key in target) if (key !== 'num') row[key] = target[key];
		row.sid = target.sid || targetEntry.spriteid;
		artParents.set(id, targetId);
		aliasCount++;
	}
	fallbackCount += aliasCount;

	applyScales(rows, rowById, artParents, getShowdownSizes(upstream));
	for (const {id, row} of rows) {
		buf += rowToString(id, row);
	}

	buf = buf.slice(0, -2) + `
};
`;

	fs.writeFileSync('data/pokedex-mini.js', buf);

	// BW (gen5) sprites aren't part of the Dystoria set: keep upstream's table as-is.
	fs.writeFileSync('data/pokedex-mini-bw.js', remoteBWText || `exports.BattlePokemonSpritesBW = {};\n`);

	return {r2Count, psCount, fallbackCount};
}

(async () => {
	if (!manifest) {
		try {
			fs.unlinkSync('data/pokedex-mini.js');
			fs.unlinkSync('data/pokedex-mini-bw.js');
		} catch (e) {}
		console.log('SKIPPED (no build-tools/sprite-sizes.json: run once with SPRITE_SRC set)');
		return;
	}
	const {r2Count, psCount, fallbackCount} = await updateSizes();
	console.log(`DONE (source: ${spriteSrc || 'build-tools/sprite-sizes.json'}; ${r2Count} species from R2 set, ${fallbackCount} reuse a parent forme's render, ${psCount} from upstream)`);
})();
